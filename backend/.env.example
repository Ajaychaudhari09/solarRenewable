# ─────────────────────────────────────────────
# GridPulse AI — Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────

# ── IBM watsonx.ai / Granite ──────────────────
# Get your API key from: https://cloud.ibm.com/iam/apikeys
GRANITE_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai project ID (create at https://dataplatform.cloud.ibm.com)
# Leave blank to attempt auto-discovery (requires API key with project access)
GRANITE_PROJECT_ID=

# watsonx.ai endpoint (us-south, eu-de, etc.)
GRANITE_URL=https://us-south.ml.cloud.ibm.com

# Granite model to use
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── IBM Watson Orchestrate (optional) ─────────
ORCHESTRATE_APIKEY=your_orchestrate_api_key
ORCHESTRATE_URL=https://api.au-syd.watson-orchestrate.cloud.ibm.com/instances/your-instance-id
ORCHESTRATE_AUTH_TYPE=iam

# ── Application ───────────────────────────────
APP_ENV=demo
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Simulation ────────────────────────────────
SIMULATION_SEED=42
SIMULATION_TICK_SECONDS=5

# ── Energy Pricing (INR/MWh) ──────────────────
ENERGY_PRICE_INR_PER_MWH=3200

# ── Carbon factor (kg CO₂ per kWh, India grid average) ──
GRID_EMISSIONS_FACTOR_KG_PER_KWH=0.71
